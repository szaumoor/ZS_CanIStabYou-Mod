OUTER_SET dragon = IDS_OF_SYMBOL(race DRAGON)
COPY_EXISTING_REGEXP ~^.+\.cre$~ ~override~
  READ_BYTE 0x272 race
  PATCH_IF race = dragon
    AND NOT "%SOURCE_RES%" STR_EQ "dragblue"
    AND NOT "%SOURCE_RES%" STR_EQ "abazigal"
  BEGIN
    LPF DELETE_EFFECT INT_VAR match_opcode = 292 END
  END
BUT_ONLY
